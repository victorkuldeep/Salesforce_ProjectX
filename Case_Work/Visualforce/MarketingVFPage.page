<apex:page controller="MarketingMaterialRequestController"
    lightningStylesheets="true"
    showHeader="false"
    sidebar="false"
    docType="html-5.0"
>
    <script>
        function closeWindow() {
            window.open('', '_self', '');
            window.close();
        }
        function disableSubmitButton() {
            var btn = document.getElementById('{!$Component.theButton}');
            if (btn) {
                btn.disabled = true;
                btn.style.opacity = 0.6;
                btn.style.cursor = 'not-allowed';
            }
        }

        function enableSubmitButton() {
            var btn = document.getElementById('{!$Component.theButton}');
            if (btn) {
                btn.disabled = false;
                btn.style.opacity = 1;
                btn.style.cursor = 'pointer';
            }
        }
    </script>
    <apex:form >
        <style>
            body {
                font-family: Arial, sans-serif;
                background-color: #f8f8f8;
                display: flex;
                justify-content: center;
                padding: 40px;
            }

            .form-box {
                background: #fff;
                padding: 30px;
                max-width: 800px;
                width: 100%;
                border-radius: 10px;
                box-shadow: 0 0 15px rgba(0,0,0,0.1);
            }

            .logo {
                text-align: center;
                margin-bottom: 20px;
            }

            .logo img {
                max-height: 60px;
            }

            .contentData {
                text-align: center;
                margin-top: 20px;
                margin-bottom: 30px;
                font-weight: bold;
                font-size: 24px;
            }

            .section-title {
                font-weight: bold;
                font-size: 16px;
                margin-top: 20px;
                margin-bottom: 10px;
            }

            label {
                font-weight: normal;
                font-size: 14px;
                display: block;
                margin-bottom: 5px;
            }

            .required-star {
                color: red;
                margin-left: 2px;
            }

            .row {
                display: flex;
                gap: 15px;
                margin-bottom: 15px;
            }

            .row > * {
                flex: 1;
            }

            .full-width {
                width: 100%;
                margin-bottom: 15px;
            }

            input, select, textarea {
                width: 100%;
                padding: 8px;
                border: 1px solid #ccc;
                border-radius: 5px;
                box-sizing: border-box;
            }

            textarea {
                resize: vertical;
            }

            .checkbox-table {
                width: 100%;
                border-spacing: 0 10px;
            }

            .checkbox-table td {
                vertical-align: middle;
                padding: 5px 10px;
            }

            .checkbox-table input[type="checkbox"] {
                margin-right: 10px;
            }

            .button-row {
                padding: 10px 20px;
                margin-left: 10px;
                cursor: pointer;
                font-size: 16px !important;
                font-family: Arial, sans-serif !important;
                font-weight: bold !important;
                width: auto; /* prevents it from taking full width */
                min-width: 100px; /* ensures it has a minimum width */
                display: inline-block; /* key to making it size naturally */
            }

                .image-grid {
                    display: grid;
                    grid-template-columns: repeat(4, 1fr);
                    gap: 20px;
                    margin-top: 20px;
                    text-align: center;
                }

                .image-grid a {
                    text-decoration: none;
                    color: #0070d2;
                    font-weight: bold;
                    display: flex;                /* Flexbox to center content */
                    align-items: center;          /* Vertical centering */
                    justify-content: center;      /* Horizontal centering */
                    text-align: center;
                    margin-bottom: 5px;
                    min-height: 3em;              /* Space for 2 lines */
                    line-height: 1.4em;
                    overflow: hidden;
                    padding: 0 5px;               /* Optional: prevent text from touching edges */
                }

                .image-grid img {
                    width: 100%;
                    border-radius: 8px;
                    border: 1px solid #ddd;
                    max-height: 100px;
                    object-fit: cover;
                }
        </style>

        <div class="form-box">
            <div class="logo">
                <div>
                    <img src="{!URLFOR($Resource.shift4logo)}" alt="Shift4" />
                </div>
                <div class = "contentData">
                    <h2>Marketing Material Request Form</h2>
                </div>
            </div>
            <div>
                <apex:pageMessages />
                <apex:outputPanel id="popup">
                    <apex:outputPanel rendered="{!showSuccessPopup}">
                        <div id="popup-overlay" style="position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); display:flex; justify-content:center; align-items:center; z-index:9999;">
                            <div style="background:white; padding:30px; border-radius:10px; width:600px; text-align:center;">
                                <h3 style="color:green;">Request Submitted Successfully</h3>
                                <p>Your marketing material request has been submitted. Please note {!caseRef} for future reference</p>
                                <button onclick="closeWindow()" style="margin-top:20px; padding:8px 16px; background:#0070d2; color:white; border:none; border-radius:5px; cursor:pointer;">Close</button>
                            </div>
                        </div>
                    </apex:outputPanel>
                </apex:outputPanel>
                <apex:outputPanel id="popupError">
                    <apex:outputPanel id="errorPopup" rendered="{!showErrorPopup}">
                        <div id="popup-overlay" style="position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); display:flex; justify-content:center; align-items:center; z-index:9999;">
                            <div style="background:white; padding:30px; border-radius:10px; width:600px; text-align:center;">
                                <h3 style="color:red;">Request Submission Failed</h3>
                                <p>There is some Error while processing request:</p>

                                <table style="margin: 20px auto; border-collapse: collapse; width: 90%; text-align: left;">
                                    <thead>
                                        <tr>
                                            <th style="border-bottom:1px solid #ccc; padding: 8px; font-weight: bold;">#</th>
                                            <th style="border-bottom:1px solid #ccc; padding: 8px; font-weight: bold;">Error Message</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <apex:variable var="index" value="{!0}" />
                                        <apex:repeat value="{!errorMessages}" var="msg">
                                            <apex:variable var="index" value="{!index + 1}" />
                                            <tr>
                                                <td style="padding:8px; vertical-align: top;">{!index}.</td>
                                                <td style="padding:8px;">{!msg}</td>
                                            </tr>
                                        </apex:repeat>
                                    </tbody>
                                </table>                                
                                <apex:commandButton action="{!closeError}" value="Close" onclick="enableSubmitButton();" id="thecloseButton" 
                                    style="margin-top:20px; background:#0070d2; color:white; border:none; border-radius:5px; cursor:pointer; 
                                        display:inline-block; width:auto; max-width: 200px; font-size: 14px !important;
                                        font-family: Arial, sans-serif !important;
                                        font-weight: normal !important;" 
                                    reRender="popupError" />
                            </div>
                        </div>
                    </apex:outputPanel>

                </apex:outputPanel>
            </div>
            <div class="section-title">Your Information</div>

            <!-- Name and Email - refactored with spacing like city/state -->
            <div class="row">
                <div>
                    <label>Name<span class="required-star">*</span></label>
                    <apex:inputText value="{!firstName}" required="true" html-placeholder="First" styleClass="input" />
                </div>
                <div>
                    <label>&nbsp;</label>
                    <apex:inputText value="{!lastName}" required="true" html-placeholder="Last" styleClass="input" />
                </div>
                <div>
                    <label>Email<span class="required-star">*</span></label>
                    <apex:inputText value="{!email}" required="true" html-placeholder="Email" styleClass="input" />
                </div>
            </div>

            <!-- Shipping Address -->
            <label>Shipping Address<span class="required-star">*</span></label>
            <div class="full-width">
                <apex:inputText value="{!shippingAddress1}" required="true" html-placeholder="Address Line 1" styleClass="input" />
            </div>
            <div class="full-width">
                <apex:inputText value="{!shippingAddress2}" html-placeholder="Address Line 2" styleClass="input" />
            </div>

            <div class="row">
                <apex:inputText value="{!city}" html-placeholder="City" styleClass="input" />
                <apex:inputText value="{!state}" html-placeholder="State / Province / Region" styleClass="input" />
                <apex:inputText value="{!postalcode}" html-placeholder="Postal / Zip Code" styleClass="input" />
                <apex:selectList value="{!country}" size="1" styleClass="input" required="false">
                    <apex:selectOptions value="{!countryOptions}" />
                </apex:selectList>
            </div>

            <!-- Partner Type & Office -->
            <div class="row">
                <div>
                    <label>Partner Type<span class="required-star">*</span></label>
                    <apex:selectList value="{!partnerType}" size="1" styleClass="input" required="false">
                        <apex:selectOptions value="{!partnerTypeOptions}" />
                    </apex:selectList>
                </div>
                <div>
                    <label>Office Code</label>
                    <apex:inputText value="{!officeCode}" html-placeholder="Office Code" styleClass="input" />
                </div>
            </div>
            <div class="section-title">
                Request Printed Material
            </div>
            <div>
                <label>Take a look at our current offerings of printed marketing material then select what you would like below.</label>
            </div>
            
            <!-- 8 Images -->
            <div class="image-grid">
                <apex:repeat value="{!imageList}" var="img">
                    <div>
                        <a href="{!img.link}" target="_blank">{!img.title}</a><br/>
                        <img src="{!img.imgUrl}" />
                    </div>
                </apex:repeat>
            </div>

            <!-- Materials Checkboxes in table -->
            <div class="section-title">
                What materials would you like to request?
            </div>
            <table class="checkbox-table">
                <apex:repeat value="{!pairList}" var="pair">
                    <tr>
                        <td>
                            <apex:inputCheckbox value="{!pair.left.selected}" />
                        </td>
                        <td>{!pair.left.name}</td>
                        <apex:outputPanel rendered="{!NOT(ISNULL(pair.right))}">
                            <td>
                                <apex:inputCheckbox value="{!pair.right.selected}" />
                            </td>
                            <td>{!pair.right.name}</td>
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!ISNULL(pair.right)}">
                            <td colspan="2"></td>
                        </apex:outputPanel>
                    </tr>
                </apex:repeat>
            </table>

            <!-- Comments -->
            <div class="section-title">Comments</div>
            <apex:inputTextarea value="{!comments}" rows="3" html-placeholder="Your comments here..."/>
            
            <!-- CONTAINER handles alignment -->
            <div style="text-align: right; margin-top: 1rem;">
                <apex:commandButton 
                    action="{!submitMarketingRequest}" 
                    value="Save" 
                    id="theButton" 
                    styleClass="button-row" 
                    reRender="popup, popupError"
                    onclick="disableSubmitButton();"
                />
            </div>            
        </div>
    </apex:form>
</apex:page>